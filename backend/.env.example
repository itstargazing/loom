# Database
DATABASE_URL=postgresql+asyncpg://loom:loom@localhost:5432/loom

# Redis
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed dashboard origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Chrome extension pages call the API directly (upload fields, watch tab).
CORS_ORIGIN_REGEX=chrome-extension://.*

# Stub auth — shared secret between the extension, dashboard, and this API.
# Replace get_current_user_id() when Clerk/Supabase sessions land.
STUB_AUTH_TOKEN=loom-dev-token
STUB_USER_ID=dev-user

# Caps the synchronous reclassify endpoint (user-triggered AI calls).
CLASSIFICATION_RATE_LIMIT_PER_MINUTE=30

# Capture ingest limits
MAX_EVENTS_PER_BATCH=100
MAX_PAYLOAD_CHARS=200000
CAPTURE_STREAM_MAX_LEN=100000

# Worker tuning
WORKER_BATCH_SIZE=50
WORKER_BLOCK_MS=5000
WORKER_CLAIM_MIN_IDLE_MS=60000

# AI classification
# "claude" uses the Anthropic Messages API (set ANTHROPIC_API_KEY).
# "openai" targets any OpenAI-compatible endpoint.
# "stub" is offline keyword heuristics. Empty keys fall back to stub.
AI_PROVIDER=stub
AI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2000
EMBEDDING_PROVIDER=stub
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_RATE_LIMIT_PER_MINUTE=20
CLASSIFICATION_AUTO_ROUTE_MIN_CONFIDENCE=0.5

# Smaller than WORKER_BATCH_SIZE because each entry costs one model call.
CLASSIFICATION_BATCH_SIZE=10

# Contradiction watcher
CONTRADICTION_WATCH_INTERVAL_SECONDS=30
CONTRADICTION_LOOKBACK_DAYS=30

# Reading compiler (matches the extension dwell threshold)
READING_DWELL_THRESHOLD_MS=3000

# Form filler
FORM_STORAGE_DIR=.data/forms
FORM_MATCH_MIN_CONFIDENCE=0.75
FORM_UPLOAD_MAX_BYTES=20971520

# Live doc diff
LIVE_DOC_DIFF_INTERVAL_SECONDS=45

# Auto-attach (suggestions only; never attaches without confirmation)
AUTO_ATTACH_MIN_CONFIDENCE=0.75

# Local-only sensitive mode: hostname suffixes or exact hosts.
# Matching URLs skip cloud AI and use local heuristics.
LOCAL_ONLY_DOMAINS=.gov,bank.example.com
