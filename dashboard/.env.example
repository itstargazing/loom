# Dashboard (Next.js) — copy to .env.local for local work.
# Clerk keys: run `npx clerk@latest init --accountless -y` or `clerk env pull`.

LOOM_API_URL=http://localhost:8000

# Only used when Clerk keys are absent AND NODE_ENV is not production.
# Never relied on for Vercel / production builds.
LOOM_API_TOKEN=loom-dev-token

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Optional Sentry (install already includes @sentry/nextjs)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
